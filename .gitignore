# trunk's web build output
dist/
dist-release/

# iOS: made by tools/mobile/build-ios.sh (ADR-030), never committed
mobile/ios/Generated/
mobile/ios/Lectio.xcodeproj/
mobile/ios/Lectio/Info.plist
mobile/ios/Lectio/Assets.xcassets/AppIcon.appiconset/AppIcon.png
mobile/ios/build/
xcuserdata/

# Android: made by tools/mobile/build-android.sh and Gradle (ADR-033); nothing
# machine-specific (local.properties has the SDK path) and no keystores
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/src/main/jniLibs/
mobile/android/app/src/generated/
mobile/android/app/src/main/res/drawable-nodpi/ic_launcher_foreground.png
mobile/android/app/src/main/res/drawable-nodpi/ic_launcher_monochrome.png
mobile/android/local.properties
mobile/android/.idea/
*.iml
*.jks
*.keystore
# The upload key's settings (ADR-038): local only, never committed
mobile/android/keystore.properties

# Stores (ADR-039..041): screenshots are made by tools/store/screenshots.sh;
# fastlane's own outputs, keys and the Ruby bundle stay local
mobile/ios/fastlane/screenshots/
mobile/android/fastlane/metadata/android/*/images/phoneScreenshots/
mobile/android/fastlane/metadata/android/*/images/sevenInchScreenshots/
mobile/android/fastlane/metadata/android/*/images/tenInchScreenshots/
mobile/*/fastlane/report.xml
mobile/*/fastlane/Preview.html
mobile/*/fastlane/README.md
mobile/*/fastlane/test_output/
mobile/.bundle/
*.p8
*.mobileprovision

# IDE settings (Android Studio, IntelliJ)
.idea/
