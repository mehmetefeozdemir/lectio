# App Store lanes (ADR-041). From app/mobile/ios:  bundle exec fastlane <lane>
#
# Secrets come only from the environment:
#   LECTIO_TEAM_ID                 the Apple Developer team id (10 characters)
#   APP_STORE_CONNECT_KEY_ID       App Store Connect › Users and Access › Integrations › Keys
#   APP_STORE_CONNECT_ISSUER_ID
#   APP_STORE_CONNECT_KEY_PATH     path to the downloaded AuthKey_<id>.p8
default_platform(:ios)

APP_DIR = File.expand_path("../../..", __dir__)
APP_ID = "io.github.mehmetefeozdemir.lectio"

platform :ios do
  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH"),
    )
  end

  desc "Archive the App Store build (tools/mobile/archive-ios.sh) and upload it to TestFlight"
  lane :beta do
    key = api_key
    sh(File.join(APP_DIR, "tools/mobile/archive-ios.sh"))
    upload_to_testflight(
      api_key: key,
      ipa: File.join(APP_DIR, "target/ios-release/export/Lectio.ipa"),
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload the listing: text, URLs, categories, screenshots, age rating, review notes (no build, no submission)"
  lane :metadata do
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      metadata_path: File.join(__dir__, "metadata"),
      screenshots_path: File.join(__dir__, "screenshots"),
      app_rating_config_path: File.join(__dir__, "app_rating_config.json"),
      overwrite_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  desc "App Privacy: Data Not Collected (signs in with your Apple ID: FASTLANE_USER)"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      username: ENV.fetch("FASTLANE_USER"),
      app_identifier: APP_ID,
      json_path: File.join(__dir__, "app_privacy_details.json"),
    )
  end
end
