<?xml version="1.0" encoding="UTF-8"?>
<!-- Lectio's Windows installer (WiX v4/v5 source, ADR-028). Built by
     tools/package/windows.ps1 with `wix build -d Version=… -d Exe=…`.
     The UpgradeCode must never change: it is how Windows knows a new
     version replaces the old one. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Lectio" Manufacturer="Lectio" Version="$(Version)"
           UpgradeCode="7B1E2C3A-5D4F-4E8B-9A6C-2F0D1E3B4C5A" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Lectio is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Lectio">
        <Component Id="LectioExe">
          <File Id="LectioExeFile" Source="$(Exe)" Name="Lectio.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="LectioShortcut" Name="Lectio" Description="Lecture notes timestamped to the audio"
                  Target="[INSTALLFOLDER]Lectio.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Lectio" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Lectio">
      <ComponentRef Id="LectioExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
